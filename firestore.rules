rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function myProfile() {
   return get(/databases/$(database)/documents/users/$(request.auth.uid));
  }
  function active() {
   return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
     && myProfile().data.status == 'active';
  }
  function commissioner() { return active() && myProfile().data.role == 'commissioner'; }
  function personnel() {
   return active() && myProfile().data.role in ['commissioner', 'supervisor', 'staff', 'auditor'];
  }
  match /users/{uid} {
   allow get: if active() && (request.auth.uid == uid || commissioner());
   allow list: if commissioner();
   allow create, update, delete: if false;
  }
  match /taxpayers/{id} {
   allow get: if personnel() || (active() && resource.data.ownerUid == request.auth.uid);
   allow list: if personnel();
   allow create, update, delete: if false;
  }
  match /auditLogs/{id} {
   allow get, list: if personnel();
   allow create, update, delete: if false;
  }
  // Generation 2 uses Functions exclusively for filings, assessments and tax policy.
  // No direct client reads or writes: results are filtered by account role and ownership.
  match /taxReturns/{id} {
   allow read, write: if false;
  }
  match /taxAssessments/{id} {
   allow read, write: if false;
  }
  match /taxPolicies/{id} {
   allow read, write: if false;
  }
  // Generation 3: financial records are server-only, including accounting charts.
  match /treasuryAccounts/{id} { allow read, write: if false; }
  match /treasuryJournals/{id} { allow read, write: if false; }
  match /treasuryReceipts/{id} { allow read, write: if false; }
  match /treasuryRefunds/{id} { allow read, write: if false; }
  match /treasuryPlans/{id} { allow read, write: if false; }
  match /treasuryChart/{id} { allow read, write: if false; }
  match /treasuryControl/{id} { allow read, write: if false; }
  match /treasuryReconciliations/{id} { allow read, write: if false; }
  // Generation 4: case files, notices, timelines and approved adjustment records
  // are restricted to server-side functions (user-specific filtered responses).
  match /agencyCases/{id} { allow read, write: if false; }
  match /agencyCaseEvents/{id} { allow read, write: if false; }
  match /agencyNotices/{id} { allow read, write: if false; }
  match /agencyCaseAdjustments/{id} { allow read, write: if false; }
  // Generation 5 uses callable Functions exclusively, including simulation state.
  match /simulationRuns/{id} { allow read, write: if false; }
  match /simulationEvents/{id} { allow read, write: if false; }
  // Generation 6 immutable executive reporting records are server-controlled.
  match /executiveReports/{id} { allow read, write: if false; }
  match /system/{id} {
   allow read, write: if false;
  }
  match /{document=**} {
   allow read, write: if false;
  }
 }
}